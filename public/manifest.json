{
  "$schema": "https://www.schemastore.org/web-manifest-combined.json",
  "name": "Aboshi",
  "description": "Aboshi is an App to manage your monthly budget.",
  "background_color": "#fff",
  "theme_color": "#fff",
  "icons": [
    {
      "src": "/appicon-256x256.png",
      "sizes": "256x256"
    },
    {
      "src": "/appicon-512x512.png",
      "sizes": "512x512"
    },
    {
      "src": "/appicon-192x192.png",
      "sizes": "192x192"
    }
  ],
  "screenshots": [
    {
      "src": "/images/screenshot-wide.png",
      "type": "image/png",
      "sizes": "1920x1128",
      "form_factor": "wide"
    },
    {
      "src": "/images/screenshot-narrow.jpg",
      "form_factor": "narrow",
      "type": "image/jpeg",
      "sizes": "1170x2391"
    }
  ],
  "start_url": "/",
  "display": "standalone"
}